#
# Run at every build (cmake -P): writes the git commit of the source tree
# into the plugin's version header, so INFORMATION_SCHEMA.PLUGINS, the
# duckdb_version status variable and the error log say which code a
# ha_duckdb.so was built from. "-dirty": built with uncommitted changes.
# The header is rewritten only when its content changes, so an unchanged
# commit recompiles nothing.
# Inputs: SOURCE_DIR (the source tree), OUTPUT (the header to write).

set(commit "unknown")
find_package(Git QUIET)
if(GIT_FOUND)
  execute_process(
    COMMAND "${GIT_EXECUTABLE}" -C "${SOURCE_DIR}" describe --always --dirty --abbrev=12
    OUTPUT_VARIABLE git_out
    RESULT_VARIABLE git_rc
    OUTPUT_STRIP_TRAILING_WHITESPACE
    ERROR_QUIET)
  if(git_rc EQUAL 0 AND NOT git_out STREQUAL "")
    set(commit "${git_out}")
  endif()
endif()

set(content "/* Generated by duckdb_version.cmake at build time. Do not edit. */
#ifndef STORAGE_DUCKDB_PLUGIN_VERSION_H_
#define STORAGE_DUCKDB_PLUGIN_VERSION_H_
#define DUCKDB_PLUGIN_COMMIT \"${commit}\"
#endif
")

set(old "")
if(EXISTS "${OUTPUT}")
  file(READ "${OUTPUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${OUTPUT}" "${content}")
  message(STATUS "DuckDB plugin version: commit ${commit}")
endif()
