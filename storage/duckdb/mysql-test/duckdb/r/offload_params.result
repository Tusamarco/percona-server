SET NAMES utf8mb4;
CREATE TABLE pv (id INT PRIMARY KEY, n INT, d DECIMAL(10,2), f DOUBLE, s VARCHAR(20) COLLATE utf8mb4_0900_ai_ci,
b VARCHAR(20) COLLATE utf8mb4_bin, dt DATE, u BIGINT UNSIGNED) SECONDARY_ENGINE = duckdb;
INSERT INTO pv VALUES (1, 1, 1.25, 0.1, 'José', 'abc', '2024-01-31', 1), (2, 2, 2.50, 0.2, 'jose', 'abc ', '2024-02-29', 18446744073709551615),
(3, 3, NULL, 1e10, 'Ana', 'xyz', '2024-03-01', 5), (4, NULL, 3.75, NULL, NULL, NULL, NULL, NULL), (5, 5, 1.25, 0.3, 'ANA', 'Abc', '2025-01-01', 7);
ALTER TABLE pv SECONDARY_LOAD;
# Prepared statements
PREPARE p1 FROM 'SELECT id FROM pv WHERE n > ? ORDER BY id';
SET @v = 2;
# EXECUTE p1 USING @v
SET @v = 0;
# EXECUTE p1 USING @v
PREPARE p2 FROM 'SELECT id, s FROM pv WHERE s = ? ORDER BY id';
SET @s = 'JOSE';
# EXECUTE p2 USING @s
PREPARE p3 FROM 'SELECT id FROM pv WHERE d = ? OR f > ? OR u = ? OR b = ? ORDER BY id';
SET @d = 1.25, @f = 1e9, @u = 18446744073709551615, @b = 'xyz';
# EXECUTE p3 USING @d, @f, @u, @b
PREPARE p4 FROM 'SELECT id FROM pv WHERE dt >= ? ORDER BY id LIMIT ?';
SET @dt = '2024-02-01', @l = 2;
# EXECUTE p4 USING @dt, @l
PREPARE p5 FROM 'SELECT COUNT(*), SUM(d) FROM pv WHERE n > ? OR n IS NULL';
SET @v = NULL;
# EXECUTE p5 USING @v
DEALLOCATE PREPARE p1;
DEALLOCATE PREPARE p2;
DEALLOCATE PREPARE p3;
DEALLOCATE PREPARE p4;
DEALLOCATE PREPARE p5;
