# Stored programs
CREATE PROCEDURE pvp(v INT, nm VARCHAR(20))
BEGIN
DECLARE k DECIMAL(10,2) DEFAULT 2.00;
SELECT id FROM pv WHERE n >= v AND d >= k ORDER BY id;
SELECT id FROM pv WHERE s = nm ORDER BY id;
END//
