CREATE TABLE pc (id INT PRIMARY KEY, c CHAR(8) COLLATE utf8mb4_bin, v VARCHAR(8) COLLATE utf8mb4_bin, s VARCHAR(20) COLLATE utf8mb4_bin) SECONDARY_ENGINE = duckdb;
INSERT INTO pc VALUES (1, 'MED BOX', 'MED BOX', '13-abc'), (2, 'MED', 'MED ', '31-x'), (3, '', '', ''),
(4, NULL, NULL, NULL), (5, 'a b', 'a b  ', '7'), (6, 'MED  BOX', 'MED BOX ', '13');
CREATE TABLE od (ok INT PRIMARY KEY, pr CHAR(8) COLLATE utf8mb4_bin, ck INT) SECONDARY_ENGINE = duckdb;
CREATE TABLE li (id INT PRIMARY KEY, ok INT, qty INT) SECONDARY_ENGINE = duckdb;
INSERT INTO od VALUES (1, 'URGENT', 1), (2, 'LOW', 2), (3, 'LOW', 3), (4, 'URGENT', NULL), (5, 'LOW', 1);
INSERT INTO li VALUES (1, 1, 50), (2, 2, 10), (3, 2, 60), (4, 3, 5), (5, 9, 70), (6, 3, 51);
ALTER TABLE pc SECONDARY_LOAD;
ALTER TABLE od SECONDARY_LOAD;
ALTER TABLE li SECONDARY_LOAD;
# CHAR equality without rtrim (padded constants as in MySQL)
# SELECT id FROM pc WHERE c = 'MED BOX   ' ORDER BY id
# SELECT id FROM pc WHERE c <> 'MED' AND c IN ('MED BOX', 'a b  ', '') ORDER BY id
# SELECT a.id, b.id FROM pc a JOIN pc b ON a.c = b.v ORDER BY 1, 2
# SELECT c, COUNT(*) FROM pc GROUP BY c ORDER BY c
# A derived table's CHAR column holding a value with trailing spaces
# (UNION ALL with a padded literal): compared with rtrim, as MySQL
# SELECT id FROM (SELECT id, c AS x FROM pc UNION ALL SELECT 99, 'MED   ') d WHERE x = 'MED' ORDER BY id
# SELECT id, x FROM (SELECT id, c AS x FROM pc UNION ALL SELECT 99, 'MED   ') d WHERE x IN ('MED ', 'a b') ORDER BY id
# Loaded under PAD_CHAR_TO_FULL_LENGTH: stored without the padding
ALTER TABLE pc SECONDARY_UNLOAD;
SET SESSION sql_mode = 'PAD_CHAR_TO_FULL_LENGTH';
ALTER TABLE pc SECONDARY_LOAD;
SET SESSION sql_mode = DEFAULT;
