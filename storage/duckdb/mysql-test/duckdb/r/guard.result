GRANT DUCKDB_HISTORY_READER ON *.* TO root@localhost;
CREATE VIEW vh AS SELECT id, grp, v FROM hist;
CREATE PROCEDURE ph() SELECT COUNT(*) FROM hist;
CREATE TABLE hcopy (id INT PRIMARY KEY, v INT);
SELECT PLUGIN_NAME, PLUGIN_STATUS FROM information_schema.PLUGINS WHERE PLUGIN_NAME = 'duckdb_guard';
PLUGIN_NAME	PLUGIN_STATUS
duckdb_guard	ACTIVE
