Got one of the listed errors
# PAD_CHAR_TO_FULL_LENGTH: MySQL pads CHAR values, the copy does not
SET @old_mode = @@SESSION.sql_mode;
SET SESSION sql_mode = CONCAT(@@sql_mode, ',PAD_CHAR_TO_FULL_LENGTH');
Warnings:
Warning	3090	Changing sql mode 'PAD_CHAR_TO_FULL_LENGTH' is deprecated. It will be removed in a future release.
SET SESSION use_secondary_engine = FORCED;
SELECT cb FROM d WHERE id = 1;
ERROR HY000: the DuckDB secondary engine cannot run this query: sql_mode:PAD_CHAR_TO_FULL_LENGTH
SET SESSION use_secondary_engine = DEFAULT;
SET SESSION sql_mode = @old_mode;
DROP TABLE d, f;
