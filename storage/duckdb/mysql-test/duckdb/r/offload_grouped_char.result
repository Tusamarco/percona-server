CREATE TABLE d (id INT PRIMARY KEY, cb CHAR(10) CHARACTER SET latin1 COLLATE latin1_bin, cu CHAR(10) COLLATE utf8mb4_bin,
vb VARCHAR(10) COLLATE utf8mb4_bin, cc CHAR(10) COLLATE utf8mb4_0900_ai_ci) SECONDARY_ENGINE = duckdb;
CREATE TABLE f (id INT PRIMARY KEY, did INT, amt INT) SECONDARY_ENGINE = duckdb;
INSERT INTO d VALUES (1, 'abc', 'abc', 'abc', 'abc'), (2, 'abc  ', 'abc  ', 'abc ', 'ABC'), (3, 'xyz', 'xyz', 'xyz', 'xyz'), (4, 'Abc', 'Abc', 'Abc', 'Abc');
INSERT INTO f VALUES (1, 2, 1), (2, 3, 2), (3, 4, 3), (4, 1, 4), (5, 2, 5), (6, 3, 6), (7, 4, 7), (8, 1, 8);
ALTER TABLE d SECONDARY_LOAD;
ALTER TABLE f SECONDARY_LOAD;
# changed after the load: through the binary log
INSERT INTO d VALUES (5, 'xyz   ', 'xyz   ', 'xyz', 'XYZ');
INSERT INTO f VALUES (9, 5, 100);
