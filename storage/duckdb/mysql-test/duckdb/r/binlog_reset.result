CREATE TABLE br (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE = duckdb;
INSERT INTO br VALUES (1, 1), (2, 2);
FLUSH BINARY LOGS;
FLUSH BINARY LOGS;
ALTER TABLE br SECONDARY_LOAD;
INSERT INTO br VALUES (3, 3);
RESET BINARY LOGS AND GTIDS;
SET GLOBAL duckdb_enable = OFF;
SET GLOBAL duckdb_enable = ON;
SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'duckdb_apply_reader_state_code';
VARIABLE_VALUE
5
# FIRST is accepted after the reset
SET GLOBAL duckdb_apply_start_position = 'FIRST';
