CREATE TABLE ge (id INT PRIMARY KEY, phone CHAR(15) CHARACTER SET latin1 COLLATE latin1_bin,
s VARCHAR(10) COLLATE utf8mb4_bin, l VARCHAR(10) CHARACTER SET latin1 COLLATE latin1_bin, amt DECIMAL(8,2))
SECONDARY_ENGINE = duckdb;
INSERT INTO ge VALUES (1, '13-555-0100', 'abc', 'xyz', 10.00), (2, '13-555-0101', 'abd', 'xyw', 20.50),
(3, '31-555-0102', 'bcd', 'éàü', 5.25), (4, '23-555-0103', 'bce', 'éàz', 7.00), (5, '31-555-0104', NULL, NULL, 1.00),
(6, '18-555-0105', 'cde', 'qrs', 3.00);
ALTER TABLE ge SECONDARY_LOAD;
CREATE TABLE gd (id INT PRIMARY KEY, ge_id INT) SECONDARY_ENGINE = duckdb;
INSERT INTO gd VALUES (1, 1), (2, 1), (3, 3), (4, 6);
ALTER TABLE gd SECONDARY_LOAD;
