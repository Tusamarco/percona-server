CREATE TABLE cs (id INT PRIMARY KEY, u VARCHAR(20) CHARACTER SET utf8mb4 COLLATE utf8mb4_bin,
l VARCHAR(20) CHARACTER SET latin1 COLLATE latin1_bin, c CHAR(5) COLLATE utf8mb4_bin) SECONDARY_ENGINE = duckdb;
