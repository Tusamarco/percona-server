CREATE TABLE po (pk INT PRIMARY KEY, brand CHAR(5) COLLATE utf8mb4_bin, s VARCHAR(10) COLLATE utf8mb4_bin, c VARCHAR(10) COLLATE utf8mb4_0900_ai_ci, price DECIMAL(10,2)) SECONDARY_ENGINE = duckdb;
CREATE TABLE li (id INT PRIMARY KEY, pk INT, sk INT, qty INT, price DECIMAL(10,2), s VARCHAR(10) COLLATE utf8mb4_bin, c VARCHAR(10) COLLATE utf8mb4_0900_ai_ci) SECONDARY_ENGINE = duckdb;
INSERT INTO po VALUES (1, 'B1', 'a', 'X', 10.00), (2, 'B1', 'b', 'y', 20.00), (3, 'B2', 'c', 'Z', 30.00),
(4, 'B1', 'd', 'w', 5.00), (5, NULL, NULL, NULL, NULL);
INSERT INTO li VALUES (1, 1, 1, 5, 9.00, 'a', 'x'), (2, 1, 2, 50, 11.00, 'a', 'X'), (3, 1, 1, 7, 12.00, 'a', 'x'),
(4, 2, 1, 1, 25.00, 'b', 'Y'), (5, 2, 2, 100, 15.00, 'b', 'y'), (6, 3, 3, 3, 31.00, 'c', 'z'),
(7, 3, 3, NULL, NULL, 'c', 'Z'), (8, 5, 1, 4, 1.00, NULL, NULL), (9, NULL, 1, 8, 2.00, 'q', 'q');
ALTER TABLE po SECONDARY_LOAD;
ALTER TABLE li SECONDARY_LOAD;
# TPC-H Q17's shape
# SELECT SUM(li.price) FROM li, po WHERE po.pk = li.pk AND po.brand = 'B1' AND li.qty < (SELECT 0.5 * AVG(l2.qty) FROM li l2 WHERE l2.pk = po.pk)
# plan shape: SELECT SUM(li.price) FROM li, po WHERE po.pk = li.pk AND po.brand = 'B1' AND li.qty < (SELECT 0.5 * AVG(l2.qty) FROM li l2 WHERE l2.pk = po.pk)
cross product in DuckDB plan: no
DISTINCT derived table: no
NOT EXISTS: no
LATERAL: yes
# Q2's shape: equal to the minimum of the part
# SELECT po.pk, li.id FROM po, li WHERE li.pk = po.pk AND li.price = (SELECT MIN(l2.price) FROM li l2 WHERE l2.pk = po.pk) ORDER BY 1, 2
# In the select list (LEFT JOIN): empty group gives NULL; COUNT gives 0
# SELECT po.pk, (SELECT MAX(l2.price) FROM li l2 WHERE l2.pk = po.pk), (SELECT COUNT(*) FROM li l2 WHERE l2.pk = po.pk), (SELECT COUNT(l2.qty) FROM li l2 WHERE l2.pk = po.pk) FROM po ORDER BY 1
# plan shape: SELECT po.pk, (SELECT MAX(l2.price) FROM li l2 WHERE l2.pk = po.pk), (SELECT COUNT(*) FROM li l2 WHERE l2.pk = po.pk), (SELECT COUNT(l2.qty) FROM li l2 WHERE l2.pk = po.pk) FROM po ORDER BY 1
cross product in DuckDB plan: no
DISTINCT derived table: no
NOT EXISTS: no
LATERAL: yes
# Two correlation columns (Q20's shape)
# SELECT li.id FROM li WHERE li.qty > (SELECT 0.5 * SUM(l2.qty) FROM li l2 WHERE l2.pk = li.pk AND l2.sk = li.sk) ORDER BY 1
# ALL / ANY
# SELECT po.pk FROM po WHERE po.price > ALL (SELECT l2.price FROM li l2 WHERE l2.pk = po.pk) ORDER BY 1
# plan shape: SELECT po.pk FROM po WHERE po.price > ALL (SELECT l2.price FROM li l2 WHERE l2.pk = po.pk) ORDER BY 1
cross product in DuckDB plan: no
DISTINCT derived table: no
NOT EXISTS: no
LATERAL: yes
# SELECT po.pk FROM po WHERE po.price < ANY (SELECT l2.price FROM li l2 WHERE l2.pk = po.pk) ORDER BY 1
# String keys: PAD SPACE (utf8mb4_bin) and _ci compare by rtrim / weights,
# not by DuckDB =: no LATERAL (results as InnoDB)
# SELECT po.pk, (SELECT COUNT(*) FROM li l2 WHERE l2.s = po.s) FROM po ORDER BY 1
# plan shape: SELECT po.pk, (SELECT COUNT(*) FROM li l2 WHERE l2.s = po.s) FROM po ORDER BY 1
cross product in DuckDB plan: no
DISTINCT derived table: no
NOT EXISTS: no
LATERAL: no
# SELECT po.pk, (SELECT COUNT(*) FROM li l2 WHERE l2.c = po.c) FROM po ORDER BY 1
# plan shape: SELECT po.pk, (SELECT COUNT(*) FROM li l2 WHERE l2.c = po.c) FROM po ORDER BY 1
cross product in DuckDB plan: no
DISTINCT derived table: no
NOT EXISTS: no
LATERAL: no
# Uncorrelated IN with GROUP BY (TPC-H Q18's shape): as it is, no LATERAL
# (LATERAL would make DuckDB collect every outer key first)
# SELECT po.pk FROM po WHERE po.pk IN (SELECT l2.pk FROM li l2 GROUP BY l2.pk HAVING SUM(l2.qty) > 10) ORDER BY 1
# plan shape: SELECT po.pk FROM po WHERE po.pk IN (SELECT l2.pk FROM li l2 GROUP BY l2.pk HAVING SUM(l2.qty) > 10) ORDER BY 1
cross product in DuckDB plan: no
DISTINCT derived table: no
NOT EXISTS: no
LATERAL: no
# Uncorrelated: a one-row derived table, nothing to correlate
# SELECT li.id FROM li WHERE li.qty > (SELECT AVG(qty) FROM li) ORDER BY 1
# plan shape: SELECT li.id FROM li WHERE li.qty > (SELECT AVG(qty) FROM li) ORDER BY 1
cross product in DuckDB plan: no
DISTINCT derived table: no
NOT EXISTS: no
LATERAL: no
DROP TABLE po, li;
