CREATE TABLE tc (id INT PRIMARY KEY, i INT, bi BIGINT, u INT UNSIGNED, ubi BIGINT UNSIGNED,
dc DECIMAL(10,3), dl DECIMAL(30,2), dbl DOUBLE, s VARCHAR(20), d DATE, dt DATETIME, dt3 DATETIME(3), ts TIMESTAMP NULL)
SECONDARY_ENGINE = duckdb;
