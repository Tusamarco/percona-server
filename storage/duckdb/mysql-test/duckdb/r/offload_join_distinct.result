Got one of the listed errors
# SELECT c.name, COUNT(*) FROM wo o JOIN wc c ON c.id = MONTH(o.date_created_gmt) % 4 GROUP BY c.name ORDER BY c.name
SET SESSION use_secondary_engine = FORCED;
SELECT c.name, COUNT(*) FROM wo o JOIN wc c ON c.id = MONTH(o.date_created_gmt) % 4 GROUP BY c.name ORDER BY c.name;
Got one of the listed errors
# ... but not when the query's groups do not mix them
# SELECT o.status, COUNT(*) FROM wo o JOIN wa a ON a.order_id = o.id WHERE o.id < 6 GROUP BY o.status ORDER BY o.status
SHOW GLOBAL STATUS LIKE 'duckdb_offload_last_refusal';
Variable_name	Value
duckdb_offload_last_refusal	grouped_string_value_in_join: a group holds values that are equal under the collation but stored differently ('a' and 'a ', or 'A' and 'a'); InnoDB shows one of them by its join order
# SELECT YEAR(o.date_created_gmt) AS yr, COUNT(DISTINCT o.id) AS n FROM wo o LEFT JOIN wa a ON a.order_id = o.id AND a.address_type = 'shipping' WHERE a.id IS NULL GROUP BY yr ORDER BY yr
DROP TABLE wo, wa, wc;
