CREATE TABLE wo (id BIGINT UNSIGNED PRIMARY KEY, date_created_gmt DATETIME, status VARCHAR(20) COLLATE utf8mb4_bin,
total DECIMAL(10,2)) SECONDARY_ENGINE = duckdb;
CREATE TABLE wa (id BIGINT UNSIGNED PRIMARY KEY, order_id BIGINT UNSIGNED, address_type VARCHAR(20) COLLATE utf8mb4_bin,
KEY (order_id)) SECONDARY_ENGINE = duckdb;
INSERT INTO wo VALUES (1, '2024-01-01 10:00:00', 'done', 10.50), (2, '2024-01-02 10:00:00', 'new', 20.00),
(3, '2024-02-03 10:00:00', 'done', 10.50), (4, '2024-02-04 11:00:00', NULL, NULL), (5, '2025-03-01 09:00:00', 'new', 7.25);
INSERT INTO wa VALUES (1, 1, 'billing'), (2, 1, 'shipping'), (3, 2, 'billing'), (4, 3, 'billing'), (5, 3, 'shipping'),
(6, 4, 'billing'), (7, 5, 'billing'), (8, 5, 'shipping');
CREATE TABLE wc (id INT PRIMARY KEY, name VARCHAR(10) COLLATE utf8mb4_0900_ai_ci) SECONDARY_ENGINE = duckdb;
INSERT INTO wc VALUES (0, 'gold'), (1, 'silver'), (2, 'Bronze');
ALTER TABLE wo SECONDARY_LOAD;
ALTER TABLE wa SECONDARY_LOAD;
ALTER TABLE wc SECONDARY_LOAD;
