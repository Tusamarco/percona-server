(13, 1, 2, '2024-04-10', '2024-04-05'),
(14, 1, 4, '2024-05-10', '2024-05-05'), (14, 2, 2, '2024-05-01', '2024-05-05'), (14, 3, 3, '2024-05-02', '2024-05-05');
ALTER TABLE li SECONDARY_LOAD;
ALTER TABLE su SECONDARY_LOAD;
ALTER TABLE od SECONDARY_LOAD;
