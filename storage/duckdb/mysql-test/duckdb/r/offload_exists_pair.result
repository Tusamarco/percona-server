CREATE TABLE li (ok INT, ln INT, sk INT, rd DATE, cd DATE, PRIMARY KEY (ok, ln)) SECONDARY_ENGINE = duckdb;
CREATE TABLE su (sk INT PRIMARY KEY, name VARCHAR(20) COLLATE utf8mb4_bin) SECONDARY_ENGINE = duckdb;
CREATE TABLE od (ok INT PRIMARY KEY, st CHAR(1) COLLATE utf8mb4_bin) SECONDARY_ENGINE = duckdb;
INSERT INTO su VALUES (1, 'S1'), (2, 'S2'), (3, 'S3'), (4, 'S4');
INSERT INTO od VALUES (10, 'F'), (11, 'F'), (12, 'O'), (13, 'F'), (14, 'F');
