# History table: archived ENUM / SET rows across a definition change
GRANT DUCKDB_HISTORY_READER ON *.* TO root@localhost;
CREATE TABLE eh (id INT PRIMARY KEY, e ENUM('a','b','c'), s SET('x','y','z')) SECONDARY_ENGINE = duckdb
SECONDARY_ENGINE_ATTRIBUTE = '{"retain_history": true}';
INSERT INTO eh VALUES (1,'a','x'), (2,'b','x,z'), (3,'c','y'), (4,'a','z'), (5,'b',''), (6,NULL,NULL);
ALTER TABLE eh SECONDARY_LOAD;
SET gtid_next = 'AUTOMATIC:duckdb_avoid_purge';
DELETE FROM eh WHERE id IN (1, 2);
SET gtid_next = 'AUTOMATIC';
# archived rows keep their value; the index follows the new definition,
# SET values are written in the new element order
ALTER TABLE eh MODIFY e ENUM('c','b','a','d'), MODIFY s SET('z','y','x');
SET SESSION use_secondary_engine = ON, duckdb_history_scope = FULL;
SELECT id, e, e + 0, s, s + 0 FROM eh ORDER BY id;
id	e	e + 0	s	s + 0
1	a	3	x	4
2	b	2	z,x	5
3	c	1	y	2
4	a	3	z	1
5	b	2		0
6	NULL	NULL	NULL	NULL
SELECT id FROM eh ORDER BY e, id;
id
6
3
2
5
1
4
SET SESSION duckdb_history_scope = LIVE;
# SELECT id, e, e + 0, s, s + 0 FROM eh ORDER BY id
REVOKE DUCKDB_HISTORY_READER ON *.* FROM root@localhost;
