--echo # A grouped _ci string in a join (2026-11-22): checked per group in the query.
--echo # d.c has one stored value per group: offloaded, as InnoDB
--let $query= SELECT d.c, COUNT(*) FROM cw JOIN cwd d ON d.c = cw.c GROUP BY d.c ORDER BY d.c
--source ../include/duckdb_compare.inc
