#
# The DuckDB copy follows the binary log only (2026-11-26, external review).
# A write the binary log would not carry in full is refused by the guard:
# sql_log_bin = 0, binlog_format STATEMENT or MIXED, binlog_row_image
# MINIMAL or NOBLOB. Tables without a copy, and copies only read, are not
# affected. If such a change reaches the applier anyway (here: the guard's
# check skipped with a debug point; in production a source with other
# settings), the copy is marked stale instead of silently differing.
--source include/have_debug.inc
--source ../include/have_duckdb.inc
call mtr.add_suppression("binlog applier: test.bs[12]: .*The DuckDB copy is stale");
call mtr.add_suppression("Unsafe statement written to the binary log");
call mtr.add_suppression("binlog_order_commits is OFF");
CREATE TABLE bs1 (id INT PRIMARY KEY, a INT, b VARCHAR(10)) SECONDARY_ENGINE = duckdb;
CREATE TABLE bs2 (id INT PRIMARY KEY, a INT, b VARCHAR(10)) SECONDARY_ENGINE = duckdb;
CREATE TABLE plain (id INT PRIMARY KEY, a INT);
INSERT INTO bs1 VALUES (1, 10, 'x'), (2, 20, 'y');
INSERT INTO bs2 VALUES (1, 10, 'x'), (2, 20, 'y');
INSERT INTO plain VALUES (1, 1);
ALTER TABLE bs1 SECONDARY_LOAD;
ALTER TABLE bs2 SECONDARY_LOAD;
--source ../include/wait_applier.inc

--echo # sql_log_bin = 0: every write to a table with a copy is refused
SET SESSION sql_log_bin = 0;
--error ER_SECONDARY_ENGINE_PLUGIN
INSERT INTO bs1 VALUES (3, 30, 'z');
--error ER_SECONDARY_ENGINE_PLUGIN
UPDATE bs1 SET a = 11 WHERE id = 1;
--error ER_SECONDARY_ENGINE_PLUGIN
DELETE FROM bs1 WHERE id = 2;
--error ER_SECONDARY_ENGINE_PLUGIN
REPLACE INTO bs1 VALUES (1, 12, 'w');
--error ER_SECONDARY_ENGINE_PLUGIN
TRUNCATE TABLE bs1;
--echo # ... but a table without a copy, and a copy only read, are fine
INSERT INTO plain VALUES (2, 2);
DELETE FROM plain WHERE id IN (SELECT id FROM bs1 WHERE a = 999);
SET SESSION sql_log_bin = 1;

--echo # binlog_format STATEMENT and MIXED
SET SESSION binlog_format = 'STATEMENT';
--error ER_SECONDARY_ENGINE_PLUGIN
INSERT INTO bs1 VALUES (3, 30, 'z');
--disable_warnings
INSERT INTO plain VALUES (3, 3);
--enable_warnings
SET SESSION binlog_format = 'MIXED';
--error ER_SECONDARY_ENGINE_PLUGIN
UPDATE bs1 SET a = 11 WHERE id = 1;
SET SESSION binlog_format = 'ROW';

--echo # binlog_row_image MINIMAL and NOBLOB
SET SESSION binlog_row_image = 'MINIMAL';
--error ER_SECONDARY_ENGINE_PLUGIN
UPDATE bs1 SET a = 11 WHERE id = 1;
SET SESSION binlog_row_image = 'NOBLOB';
--error ER_SECONDARY_ENGINE_PLUGIN
DELETE FROM bs1 WHERE id = 2;
SET SESSION binlog_row_image = 'FULL';

--echo # Nothing was changed: InnoDB and the copy still agree
SELECT * FROM bs1 ORDER BY id;
SET SESSION use_secondary_engine = FORCED;
SELECT * FROM bs1 ORDER BY id;
SET SESSION use_secondary_engine = DEFAULT;
SELECT TABLE_NAME, STATE FROM information_schema.DUCKDB_TABLES WHERE TABLE_NAME LIKE 'bs%' ORDER BY 1;

--echo # The applier's own checks, with the guard's check skipped:
--echo # a partial row image marks bs1 stale, a statement-logged change bs2
SET SESSION debug = '+d,duckdb_guard_skip_write_check';
SET SESSION binlog_row_image = 'MINIMAL';
UPDATE bs1 SET a = 11 WHERE id = 1;
SET SESSION binlog_row_image = 'FULL';
SET SESSION binlog_format = 'STATEMENT';
--disable_warnings
INSERT INTO bs2 VALUES (3, 30, 'z');
--enable_warnings
SET SESSION binlog_format = 'ROW';
SET SESSION debug = '-d,duckdb_guard_skip_write_check';
--source ../include/wait_applier.inc
SELECT TABLE_NAME, STATE FROM information_schema.DUCKDB_TABLES WHERE TABLE_NAME LIKE 'bs%' ORDER BY 1;
--echo # A stale copy is not read: InnoDB answers (with ON)
SELECT a FROM bs1 WHERE id = 1;

--echo # binlog_order_commits switched OFF after the load: the applier stops
--echo # with the reason; back ON and duckdb_enable OFF / ON, it resumes from
--echo # its applied position and the change arrives
CREATE TABLE bs3 (id INT PRIMARY KEY, a INT) SECONDARY_ENGINE = duckdb;
INSERT INTO bs3 VALUES (1, 1);
ALTER TABLE bs3 SECONDARY_LOAD;
--source ../include/wait_applier.inc
SET GLOBAL binlog_order_commits = OFF;
INSERT INTO bs3 VALUES (2, 2);
let $wait_condition= SELECT VARIABLE_VALUE = 'error' FROM performance_schema.global_status WHERE VARIABLE_NAME = 'duckdb_apply_reader_state';
--source include/wait_condition.inc
SET GLOBAL binlog_order_commits = ON;
SET GLOBAL duckdb_enable = OFF;
SET GLOBAL duckdb_enable = ON;
--source ../include/wait_applier.inc
SELECT VARIABLE_VALUE FROM performance_schema.global_status WHERE VARIABLE_NAME = 'duckdb_apply_reader_state';
SET SESSION use_secondary_engine = FORCED;
SET SESSION secondary_engine_cost_threshold = 0;
SELECT COUNT(*) FROM bs3;
SET SESSION secondary_engine_cost_threshold = DEFAULT;
SET SESSION use_secondary_engine = DEFAULT;

DROP TABLE bs1, bs2, bs3, plain;
--source ../include/cleanup.inc
