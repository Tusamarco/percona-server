# T1 (2026-11-23): prepared statement parameters (?), stored program
# variables and parameters, user variables (@x) were refused
# (unsupported_item, get_user_var). Their value is printed as a constant at
# every EXECUTE / CALL, typed as MySQL compares it. Results as InnoDB.
--source ../include/have_duckdb.inc
SET NAMES utf8mb4;
CREATE TABLE pv (id INT PRIMARY KEY, n INT, d DECIMAL(10,2), f DOUBLE, s VARCHAR(20) COLLATE utf8mb4_0900_ai_ci,
  b VARCHAR(20) COLLATE utf8mb4_bin, dt DATE, u BIGINT UNSIGNED) SECONDARY_ENGINE = duckdb;
INSERT INTO pv VALUES (1, 1, 1.25, 0.1, 'José', 'abc', '2024-01-31', 1), (2, 2, 2.50, 0.2, 'jose', 'abc ', '2024-02-29', 18446744073709551615),
  (3, 3, NULL, 1e10, 'Ana', 'xyz', '2024-03-01', 5), (4, NULL, 3.75, NULL, NULL, NULL, NULL, NULL), (5, 5, 1.25, 0.3, 'ANA', 'Abc', '2025-01-01', 7);
ALTER TABLE pv SECONDARY_LOAD;
--source ../include/wait_applier.inc

--echo # Prepared statements
PREPARE p1 FROM 'SELECT id FROM pv WHERE n > ? ORDER BY id';
SET @v = 2;
--let $query= EXECUTE p1 USING @v
--source ../include/duckdb_compare.inc
SET @v = 0;
--let $query= EXECUTE p1 USING @v
--source ../include/duckdb_compare.inc
PREPARE p2 FROM 'SELECT id, s FROM pv WHERE s = ? ORDER BY id';
SET @s = 'JOSE';
--let $query= EXECUTE p2 USING @s
--source ../include/duckdb_compare.inc
PREPARE p3 FROM 'SELECT id FROM pv WHERE d = ? OR f > ? OR u = ? OR b = ? ORDER BY id';
SET @d = 1.25, @f = 1e9, @u = 18446744073709551615, @b = 'xyz';
--let $query= EXECUTE p3 USING @d, @f, @u, @b
--source ../include/duckdb_compare.inc
PREPARE p4 FROM 'SELECT id FROM pv WHERE dt >= ? ORDER BY id LIMIT ?';
SET @dt = '2024-02-01', @l = 2;
--let $query= EXECUTE p4 USING @dt, @l
--source ../include/duckdb_compare.inc
PREPARE p5 FROM 'SELECT COUNT(*), SUM(d) FROM pv WHERE n > ? OR n IS NULL';
SET @v = NULL;
--let $query= EXECUTE p5 USING @v
--source ../include/duckdb_compare.inc
DEALLOCATE PREPARE p1;
DEALLOCATE PREPARE p2;
DEALLOCATE PREPARE p3;
DEALLOCATE PREPARE p4;
DEALLOCATE PREPARE p5;

--echo # User variables
SET @x = 2, @name = 'ana', @lim = 1.3;
--let $query= SELECT id FROM pv WHERE n > @x ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, s FROM pv WHERE s = @name ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, d + @lim FROM pv WHERE d > @lim ORDER BY id
--source ../include/duckdb_compare.inc

--echo # Stored programs
DELIMITER //;
CREATE PROCEDURE pvp(v INT, nm VARCHAR(20))
BEGIN
  DECLARE k DECIMAL(10,2) DEFAULT 2.00;
  SELECT id FROM pv WHERE n >= v AND d >= k ORDER BY id;
  SELECT id FROM pv WHERE s = nm ORDER BY id;
END//
DELIMITER ;//
--let $query= CALL pvp(2, 'JOSÉ')
--source ../include/duckdb_compare.inc

--echo # Assigning a user variable in the statement: refused
--let $query= SELECT id, @acc := n FROM pv ORDER BY id
--source ../include/duckdb_refused.inc

DROP PROCEDURE pvp;
DROP TABLE pv;
--source ../include/cleanup.inc
