--source ../include/duckdb_compare.inc
--let $query= SELECT id, NULLIF(grp, 3), NULLIF(b4, 'a') FROM p6 WHERE id <= 30 ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT CASE WHEN qty < 0 THEN -1 ELSE 1 END AS k, COUNT(*), SUM(amount) FROM p6 GROUP BY k ORDER BY k
--source ../include/duckdb_compare.inc
--let $query= SELECT DISTINCT grp FROM p6 ORDER BY grp
--source ../include/duckdb_compare.inc
--let $query= SELECT DISTINCT s FROM p6 ORDER BY s
--source ../include/duckdb_compare.inc
--let $query= SELECT DISTINCT raw FROM p6 ORDER BY raw
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(DISTINCT grp), COUNT(DISTINCT qty), COUNT(DISTINCT b4), COUNT(DISTINCT b3), COUNT(DISTINCT s), COUNT(DISTINCT raw) FROM p6
--source ../include/duckdb_compare.inc
--let $query= SELECT grp, COUNT(DISTINCT b4), SUM(DISTINCT qty), AVG(DISTINCT qty) FROM p6 GROUP BY grp ORDER BY grp
--source ../include/duckdb_compare.inc
--let $query= SELECT id, YEAR(d), MONTH(d), DAYOFMONTH(d), DAYOFYEAR(d), QUARTER(d), DAYOFWEEK(d), WEEKDAY(d) FROM p6 WHERE id <= 30 ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, YEAR(dt), HOUR(dt), MINUTE(dt), SECOND(dt), DATE(dt), HOUR(d) FROM p6 WHERE id <= 30 ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT YEAR(d), MONTH(d), COUNT(*), SUM(amount) FROM p6 GROUP BY YEAR(d), MONTH(d) ORDER BY 1, 2
--source ../include/duckdb_compare.inc
--let $query= SELECT DAYOFWEEK(dt), COUNT(*) FROM p6 GROUP BY DAYOFWEEK(dt) ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE d >= '2021-06-01' AND YEAR(dt) = 2021
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 LIKE 'a%'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 LIKE 'a'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 LIKE 'a_'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE s LIKE 'p%' OR s LIKE '_q'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 NOT LIKE '%b%'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 LIKE 'a|_%' ESCAPE '|'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 = 'a'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 = 'a    '
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b3 = 'x' OR b3 = 'Y'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 IN ('a', 'b ', '')
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 > 'a'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 < 'a'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 BETWEEN 'a' AND 'b'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE b4 <> 'a'
--source ../include/duckdb_compare.inc
--let $query= SELECT id, b4, b3 FROM p6 WHERE id <= 40 ORDER BY b4, id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, b4 FROM p6 WHERE id <= 40 ORDER BY b4 DESC, id DESC
--source ../include/duckdb_compare.inc
--let $query= SELECT MIN(b4), MAX(b4), MIN(b3), MAX(b3) FROM p6
--source ../include/duckdb_compare.inc
--let $query= SELECT grp, MIN(b4), MAX(b3) FROM p6 GROUP BY grp ORDER BY grp
--source ../include/duckdb_compare.inc
--let $query= SELECT b4, COUNT(*) FROM p6 GROUP BY b4 ORDER BY b4
--source ../include/duckdb_compare.inc
--let $query= SELECT b3, COUNT(*), SUM(qty) FROM p6 GROUP BY b3 HAVING COUNT(*) > 100 ORDER BY b3 DESC
--source ../include/duckdb_compare.inc
--let $query= SELECT MIN(id), MAX(id), COUNT(DISTINCT b3), COUNT(*) FROM p6 GROUP BY b4 ORDER BY MIN(id)
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE ts >= '2021-06-01 00:00:00'
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM p6 WHERE ts BETWEEN '2021-10-31 01:00:00' AND '2021-10-31 04:00:00'
--source ../include/duckdb_compare.inc
