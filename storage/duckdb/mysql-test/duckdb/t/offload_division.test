--source ../include/duckdb_compare.inc
SET SESSION div_precision_increment = 9;
--let $query= SELECT i % 5 AS g, AVG(a) + 1, AVG(a) / 3, (a / 7) * 3 FROM dv WHERE id < 20 GROUP BY g, a ORDER BY g, a
