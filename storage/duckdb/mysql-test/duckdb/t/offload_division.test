--source ../include/duckdb_compare.inc
--let $query= SELECT id FROM dv WHERE i / 4 = 2.5 OR a / 3 = 0.0167 ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, ROUND(a / 3, 1), ROUND(i / 7, 3), ROUND(-a / 7, 2) FROM dv WHERE id < 60 ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, a / b / 3, (a / 3) / (b / 7), (a / 3) + (b / 7) FROM dv WHERE id < 60 ORDER BY id
--source ../include/duckdb_compare.inc
SET SESSION div_precision_increment = 0;
