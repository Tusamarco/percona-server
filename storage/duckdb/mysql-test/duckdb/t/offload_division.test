--let $query= SELECT id, a / b, a / i, i / b, i / 3, a / 7, -a / 3, j / i FROM dv ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, (a + 1) / (b - 1), a / 2.5, 10 / i, i / j, a / 0, i / 0 FROM dv ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, a / b * 2, (a / 3) + (b / 7), ROUND(a / 3, 1), a / b / 3 FROM dv WHERE id > 1990 OR id < 40 ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT SUM(a) / 6, SUM(a) / COUNT(*), SUM(a) / SUM(b), AVG(a) / 3, SUM(i) / SUM(j) FROM dv
--source ../include/duckdb_compare.inc
--let $query= SELECT i % 10 AS g, SUM(a) / COUNT(a), SUM(b) / NULLIF(SUM(i), 0) FROM dv GROUP BY g ORDER BY g
--source ../include/duckdb_compare.inc
SET SESSION div_precision_increment = 0;
--let $query= SELECT id, a / b, i / 3, a / 7, j / i FROM dv ORDER BY id
--source ../include/duckdb_compare.inc
SET SESSION div_precision_increment = DEFAULT;
SET SESSION div_precision_increment = 9;
