# DWL#6 step 6c-2: UNION, INTERSECT, EXCEPT (section 25).
--source ../include/have_duckdb.inc
--source ../include/tables_g.inc
--source ../include/tables_p6.inc
--source ../include/tables_6c.inc

--let $query= SELECT grp FROM dim UNION SELECT grp FROM p6 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim UNION ALL SELECT grp FROM p6 WHERE id < 20 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp, name FROM dim WHERE grp < 3 UNION ALL SELECT grp, name FROM dim WHERE grp > 3 ORDER BY grp DESC LIMIT 4
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim UNION ALL SELECT grp FROM dim UNION SELECT grp FROM p6 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim UNION SELECT grp FROM p6 UNION ALL SELECT grp FROM dim ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim UNION SELECT grp FROM p6 ORDER BY 1 LIMIT 3 OFFSET 2
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim INTERSECT SELECT grp FROM p6 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim EXCEPT SELECT grp FROM p6 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM p6 WHERE id < 100 INTERSECT ALL SELECT grp FROM p6 WHERE id < 50 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM p6 WHERE id < 100 EXCEPT ALL SELECT grp FROM p6 WHERE id < 50 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM p6 WHERE id < 100 EXCEPT ALL SELECT grp FROM p6 WHERE id < 50 EXCEPT SELECT grp FROM dim WHERE grp < 2 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim WHERE grp < 2 UNION (SELECT grp FROM dim EXCEPT SELECT grp FROM p6) ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= (SELECT grp FROM p6 ORDER BY grp DESC, id LIMIT 3) UNION ALL (SELECT grp FROM dim ORDER BY grp LIMIT 2) ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim UNION ALL SELECT amount FROM p6 WHERE id < 10 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT d FROM p6 WHERE id < 5 UNION ALL SELECT dt FROM p6 WHERE id < 5 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT name FROM dim UNION SELECT s FROM p6 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp, grp FROM dim UNION SELECT grp, region FROM dim ORDER BY 1, 2
--source ../include/duckdb_compare.inc
--let $query= SELECT 'dim', COUNT(*) FROM dim UNION ALL SELECT 'p6', COUNT(*) FROM p6 ORDER BY 2
--source ../include/duckdb_compare.inc
--let $query= SELECT d.name FROM p6 JOIN dim d ON d.grp = p6.grp WHERE p6.id < 10 UNION SELECT name FROM dim WHERE grp > 7 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT id FROM hist WHERE id < 40 UNION ALL SELECT grp FROM dim ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT x.k, COUNT(*) FROM (SELECT grp AS k FROM dim UNION ALL SELECT grp FROM dim) x GROUP BY x.k ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT COUNT(*) FROM (SELECT label FROM dim UNION ALL SELECT b4 FROM p6) x
--source ../include/duckdb_compare.inc
--let $query= SELECT d.name, x.n FROM dim d JOIN (SELECT grp, COUNT(*) AS n FROM p6 GROUP BY grp UNION ALL SELECT grp, 0 FROM dim WHERE grp > 7) x ON x.grp = d.grp ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp FROM dim UNION SELECT 99 ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp, name FROM dim WHERE grp < 2 UNION ALL SELECT NULL, NULL ORDER BY 1
--source ../include/duckdb_compare.inc
--let $query= SELECT grp, d FROM p6 WHERE id < 4 UNION ALL SELECT grp, NULL FROM dim WHERE grp < 2 ORDER BY 1, 2
--source ../include/duckdb_compare.inc

