# Functions reviewed against DuckDB (section 42): dates (EXTRACT, DATE_ADD,
# DATEDIFF, TO_DAYS, LAST_DAY, DAYNAME), numbers (FLOOR, CEILING, SIGN,
# TRUNCATE, SQRT, LN, LOG, GREATEST, LEAST), strings (CHAR_LENGTH, LENGTH,
# SUBSTRING, LEFT, RIGHT, CONCAT, CONCAT_WS, TRIM, REPLACE, REVERSE, LPAD,
# RPAD, INSTR, LOCATE) with edge values; the refused ones.
--source ../include/have_duckdb.inc
SET NAMES utf8mb4;
--source ../include/tables_fx.inc

--let $query= SELECT id, EXTRACT(YEAR FROM dt), EXTRACT(QUARTER FROM dt), EXTRACT(MONTH FROM dt), EXTRACT(DAY FROM dt), EXTRACT(YEAR_MONTH FROM dt) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, EXTRACT(HOUR FROM t6), EXTRACT(MINUTE FROM t6), EXTRACT(SECOND FROM t6), EXTRACT(MICROSECOND FROM t6), EXTRACT(HOUR FROM dt) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, EXTRACT(DAY_HOUR FROM ts), EXTRACT(DAY_MINUTE FROM ts), EXTRACT(DAY_SECOND FROM ts), EXTRACT(HOUR_MINUTE FROM ts), EXTRACT(HOUR_SECOND FROM ts), EXTRACT(MINUTE_SECOND FROM ts) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, EXTRACT(DAY_MICROSECOND FROM t6), EXTRACT(HOUR_MICROSECOND FROM t6), EXTRACT(MINUTE_MICROSECOND FROM t6), EXTRACT(SECOND_MICROSECOND FROM t6) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT EXTRACT(YEAR FROM dt) AS y, COUNT(*) FROM fx GROUP BY y ORDER BY y
--source ../include/duckdb_compare.inc
--let $query= SELECT id, dt + INTERVAL 1 MONTH, dt - INTERVAL 1 MONTH, DATE_ADD(dt, INTERVAL 1 YEAR), DATE_SUB(dt, INTERVAL 2 QUARTER), ADDDATE(dt, INTERVAL 3 WEEK) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, dt + INTERVAL 1 DAY, dt - INTERVAL 1 DAY, dt + INTERVAL 5 HOUR, ts + INTERVAL 90 MINUTE, ts - INTERVAL 3600 SECOND FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, t6 + INTERVAL 1 MICROSECOND, SUBDATE(ts, INTERVAL 1 DAY), dt + INTERVAL n DAY FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, dt - INTERVAL 999 YEAR, dt - INTERVAL 1000 YEAR, dt - INTERVAL 1001 YEAR, dt + INTERVAL 1 YEAR FROM fx WHERE id IN (4, 5) ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id FROM fx WHERE dt + INTERVAL 30 DAY > '2024-03-01' ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, DATEDIFF(dt, '2024-01-01'), DATEDIFF(ts, dt), TO_DAYS(dt), LAST_DAY(dt), LAST_DAY(ts) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, DAYNAME(dt), MONTHNAME(ts) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, FLOOR(d), CEILING(d), CEIL(f), FLOOR(f), FLOOR(n), SIGN(d), SIGN(f), SIGN(n) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, TRUNCATE(d, 1), TRUNCATE(d, 0), TRUNCATE(d, -1), TRUNCATE(n, -1), TRUNCATE(n, 2) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, SQRT(f), LN(f), LOG(f), LOG2(d), LOG10(n), SQRT(n) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, GREATEST(n, 3, id), LEAST(d, 1.5), GREATEST(f, 0), LEAST(n, NULL) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, CHAR_LENGTH(s), CHAR_LENGTH(sl), CHAR_LENGTH(ch), LENGTH(s), LENGTH(sc), OCTET_LENGTH(ch) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, SUBSTRING(s, 2), SUBSTRING(s, 2, 3), SUBSTRING(s, 0), SUBSTRING(s, -3), SUBSTRING(s, -20), SUBSTRING(s, 2, 0), SUBSTRING(s, 2, -1) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, SUBSTR(sl, 1, 2), MID(s, 3, 2), LEFT(s, 2), LEFT(s, 0), LEFT(s, -1), RIGHT(s, 3), RIGHT(s, 0), RIGHT(sl, 20) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, CONCAT(s, '-', sl), CONCAT(s, n), CONCAT(d, '/', dt), CONCAT(ts), CONCAT('x', NULL), CONCAT_WS(',', s, NULL, n), CONCAT_WS(NULL, s) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, TRIM(s), LTRIM(s), RTRIM(s), TRIM(BOTH 'x' FROM s), TRIM(LEADING 'x' FROM s), TRIM(TRAILING 'x' FROM s) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, REPLACE(s, 'l', 'LL'), REPLACE(sc, 'a', ''), REPLACE(s, '', 'z'), REVERSE(s), REVERSE(sl) FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, LPAD(s, 8, '*'), RPAD(s, 8, 'ab'), LPAD(s, 2, '*'), LPAD(s, -1, '*'), LPAD(s, 8, ''), RPAD(sl, 3, '') FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, INSTR(s, 'l'), INSTR(s, ''), LOCATE('b', s), LOCATE('ö', s), INSTR(ch, 'x') FROM fx ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id FROM fx WHERE SUBSTR(sl, 1, 2) IN ('13', 'he', 'xx') ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT CHAR_LENGTH(s) AS l, COUNT(*) FROM fx GROUP BY l ORDER BY l
--source ../include/duckdb_compare.inc
--let $query= SELECT id, s FROM fx ORDER BY SUBSTRING(s, 2), id
--source ../include/duckdb_compare.inc
--let $query= SELECT id FROM fx WHERE CHAR_LENGTH(s) > 5 AND EXTRACT(MONTH FROM dt) IN (1, 2, 12) ORDER BY id
--source ../include/duckdb_compare.inc

--echo # Refused
--let $query= SELECT id, UPPER(s), LOWER(s) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, ASCII(s) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, EXTRACT(WEEK FROM dt) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, LENGTH(sl) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, INSTR(sc, 'h') FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, TRIM(BOTH 'xy' FROM s) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, EXP(n), POW(n, 2) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, CONCAT(f) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--let $query= SELECT id, DATE_ADD(ts, INTERVAL '1:30' HOUR_MINUTE) FROM fx ORDER BY id
--source ../include/duckdb_refused.inc
--echo # An expression under latin1_bin (2026-11-22): compared and ordered on its value
--let $query= SELECT id FROM fx WHERE SUBSTR(sl, 1, 2) > 'h' ORDER BY id
--source ../include/duckdb_compare.inc
--let $query= SELECT id, SUBSTR(sl, 1, 3) AS p FROM fx ORDER BY p, id
--source ../include/duckdb_compare.inc
--let $query= SELECT LEFT(s, 1) AS c, COUNT(*) FROM fx GROUP BY c ORDER BY c
--source ../include/duckdb_refused.inc

--echo # REVERSE by code points as MySQL: combining marks and emoji modifiers
CREATE TABLE rv (id INT PRIMARY KEY, s VARCHAR(30) COLLATE utf8mb4_bin) SECONDARY_ENGINE = duckdb;
INSERT INTO rv VALUES (1, CONCAT('e', _utf16 0x0301, 'x')), (2, CONCAT(_utf16 0xD83DDC4D, _utf16 0xD83CDFFD, 'a')),
  (3, ''), (4, NULL), (5, 'abc');
ALTER TABLE rv SECONDARY_LOAD;
--source ../include/wait_applier.inc
--let $query= SELECT id, REVERSE(s), CHAR_LENGTH(REVERSE(s)) FROM rv ORDER BY id
--source ../include/duckdb_compare.inc
DROP TABLE rv;

--echo # Negated negative constants ("--" is a comment in DuckDB), a newline in a string
--let $query= SELECT id, -(-1.5), - -2.25, -(-d), -(0 - 1.5) * n FROM fx WHERE s <> 'a\nb' ORDER BY id
--source ../include/duckdb_compare.inc

DROP TABLE fx;
--source ../include/cleanup.inc
