# GROUP BY a string expression under a PAD SPACE collation (2026-11-22,
# TPC-H Q22: GROUP BY SUBSTR(c_phone, 1, 2) under latin1_bin): grouped on
# rtrim(), the value shown checked per group; a group holding 'ab' and 'ab '
# is refused (MySQL shows the first row's).
--source ../include/have_duckdb.inc
CREATE TABLE ge (id INT PRIMARY KEY, phone CHAR(15) CHARACTER SET latin1 COLLATE latin1_bin,
  s VARCHAR(10) COLLATE utf8mb4_bin, l VARCHAR(10) CHARACTER SET latin1 COLLATE latin1_bin, amt DECIMAL(8,2))
  SECONDARY_ENGINE = duckdb;
INSERT INTO ge VALUES (1, '13-555-0100', 'abc', 'xyz', 10.00), (2, '13-555-0101', 'abd', 'xyw', 20.50),
  (3, '31-555-0102', 'bcd', 'éàü', 5.25), (4, '23-555-0103', 'bce', 'éàz', 7.00), (5, '31-555-0104', NULL, NULL, 1.00),
  (6, '18-555-0105', 'cde', 'qrs', 3.00);
ALTER TABLE ge SECONDARY_LOAD;
CREATE TABLE gd (id INT PRIMARY KEY, ge_id INT) SECONDARY_ENGINE = duckdb;
INSERT INTO gd VALUES (1, 1), (2, 1), (3, 3), (4, 6);
ALTER TABLE gd SECONDARY_LOAD;
--source ../include/wait_applier.inc

--let $query= SELECT SUBSTR(phone, 1, 2) AS cc, COUNT(*), SUM(amt) FROM ge GROUP BY cc ORDER BY cc
--source ../include/duckdb_compare.inc
--let $query= SELECT cntrycode, COUNT(*) AS numcust, SUM(amt) AS tot FROM (SELECT SUBSTR(phone, 1, 2) AS cntrycode, amt FROM ge WHERE SUBSTR(phone, 1, 2) IN ('13', '31', '18') AND NOT EXISTS (SELECT * FROM gd WHERE gd.ge_id = ge.id)) x GROUP BY cntrycode ORDER BY cntrycode
--source ../include/duckdb_compare.inc
--let $query= SELECT LEFT(s, 2) AS p, COUNT(*) FROM ge GROUP BY p ORDER BY p DESC
--source ../include/duckdb_compare.inc
--let $query= SELECT LEFT(l, 2) AS p, MAX(amt) FROM ge GROUP BY p HAVING COUNT(*) >= 1 ORDER BY p
--source ../include/duckdb_compare.inc
--let $query= SELECT SUBSTR(phone, 1, 2) AS cc, COUNT(*) FROM ge JOIN gd ON gd.ge_id = ge.id GROUP BY cc ORDER BY cc
--source ../include/duckdb_compare.inc

--echo # A group holding 'ab' and 'ab ' (PAD SPACE): refused
INSERT INTO ge VALUES (7, '17-555-0106', 'ab ', 'ab ', 2.00), (8, '17-555-0107', 'ab', 'ab', 4.00);
--source ../include/wait_applier.inc
--let $query= SELECT LEFT(s, 3) AS p, COUNT(*) FROM ge GROUP BY p ORDER BY p
--source ../include/duckdb_refused.inc
--let $query= SELECT LEFT(l, 3) AS p, COUNT(*) FROM ge GROUP BY p ORDER BY p
--source ../include/duckdb_refused.inc
--echo # ... and offloaded when the query's groups do not mix them
--let $query= SELECT LEFT(s, 3) AS p, COUNT(*) FROM ge WHERE id <> 7 GROUP BY p ORDER BY p
--source ../include/duckdb_compare.inc

DROP TABLE ge, gd;
--source ../include/cleanup.inc
