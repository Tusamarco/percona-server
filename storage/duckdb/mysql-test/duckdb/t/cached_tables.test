# DWL#6 step 6d-2 (section 27): the server keeps secondary tables cached;
# the registry never frees their entries.
--source ../include/have_duckdb.inc
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE = duckdb;
INSERT INTO t1 VALUES (1, 1), (2, 2);
ALTER TABLE t1 SECONDARY_LOAD;
--source ../include/wait_applier.inc
SET SESSION use_secondary_engine = FORCED;
SELECT SUM(v) FROM t1;
ALTER TABLE t1 SECONDARY_UNLOAD;
--error ER_SECONDARY_ENGINE_PLUGIN
SELECT SUM(v) FROM t1;
ALTER TABLE t1 SECONDARY_LOAD;
--source ../include/wait_applier.inc
SELECT SUM(v) FROM t1;
SET GLOBAL duckdb_enable = OFF;
--error ER_SECONDARY_ENGINE_PLUGIN
SELECT SUM(v) FROM t1;
SET GLOBAL duckdb_enable = ON;
--source ../include/wait_applier.inc
SELECT SUM(v) FROM t1;
DROP TABLE t1;
CREATE TABLE t1 (id INT PRIMARY KEY, v INT) SECONDARY_ENGINE = duckdb;
INSERT INTO t1 VALUES (1, 10);
ALTER TABLE t1 SECONDARY_LOAD;
--source ../include/wait_applier.inc
SELECT SUM(v) FROM t1;
SET SESSION use_secondary_engine = ON;
--source ../include/cleanup.inc
