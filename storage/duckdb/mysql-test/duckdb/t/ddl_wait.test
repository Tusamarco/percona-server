# T0 (2026-11-19): a DDL on a table with a DuckDB copy returns once the
# applier has refreshed the copy (duckdb_ddl_wait_refresh), showing its
# progress in SHOW PROCESSLIST and the Performance Schema stage; the copy is
# usable right after, with no wait_applier.
--source ../include/have_duckdb.inc
SET NAMES utf8mb4;
UPDATE performance_schema.setup_instruments SET ENABLED = 'YES', TIMED = 'YES'
  WHERE NAME LIKE 'stage/duckdb/%';
UPDATE performance_schema.setup_consumers SET ENABLED = 'YES'
  WHERE NAME = 'events_stages_current';
SELECT NAME FROM performance_schema.setup_instruments WHERE NAME LIKE 'stage/duckdb/%' ORDER BY NAME;
SELECT @@duckdb_ddl_wait_refresh, @@duckdb_ddl_wait_refresh_timeout;

CREATE TABLE dw (id INT PRIMARY KEY, a INT) SECONDARY_ENGINE = duckdb;
--disable_query_log
INSERT INTO dw WITH RECURSIVE s(n) AS (SELECT 1 UNION ALL SELECT n + 1 FROM s WHERE n < 1000) SELECT n, n % 7 FROM s;
--enable_query_log
ALTER TABLE dw SECONDARY_LOAD;
--source ../include/wait_applier.inc

--echo # The DDL returns after the refresh, with a note; the new column is in DuckDB at once
ALTER TABLE dw ADD COLUMN c INT NOT NULL DEFAULT 5;
--replace_regex /waited [0-9.]+ s/waited N s/
SHOW WARNINGS;
SELECT TABLE_NAME, STATE, REFRESH_ROWS_DONE, REFRESH_ROWS_TOTAL FROM information_schema.DUCKDB_TABLES WHERE TABLE_NAME = 'dw';
SET SESSION use_secondary_engine = FORCED, duckdb_offload_wait_applied = OFF;
SELECT c, COUNT(*) FROM dw GROUP BY c;
SET SESSION use_secondary_engine = DEFAULT, duckdb_offload_wait_applied = DEFAULT;

--echo # Another session sees the wait in SHOW PROCESSLIST and Performance Schema
--connect (con_ddl, localhost, root,,)
--let $ddl_id= `SELECT CONNECTION_ID()`
--send ALTER TABLE dw ADD COLUMN d INT NOT NULL DEFAULT 6
--connection default
--let $wait_timeout= 120
--let $wait_condition= SELECT COUNT(*) = 1 FROM information_schema.PROCESSLIST WHERE ID = $ddl_id AND STATE LIKE 'Waiting for%DuckDB%'
--source include/wait_condition.inc
--let $wait_condition= SELECT COUNT(*) = 1 FROM performance_schema.events_stages_current s JOIN performance_schema.threads t USING (THREAD_ID) WHERE t.PROCESSLIST_ID = $ddl_id AND s.EVENT_NAME LIKE 'stage/duckdb/waiting for %'
--source include/wait_condition.inc
--connection con_ddl
--reap
--replace_regex /waited [0-9.]+ s/waited N s/
SHOW WARNINGS;
--disconnect con_ddl
--connection default
SET SESSION use_secondary_engine = FORCED, duckdb_offload_wait_applied = OFF;
SELECT c, d, COUNT(*) FROM dw GROUP BY c, d;
SET SESSION use_secondary_engine = DEFAULT, duckdb_offload_wait_applied = DEFAULT;

--echo # A DDL on a table without a copy, and SECONDARY_LOAD, do not wait (no note)
CREATE TABLE nocopy (id INT PRIMARY KEY);
ALTER TABLE nocopy ADD COLUMN x INT;
SHOW WARNINGS;
DROP TABLE nocopy;

--echo # duckdb_ddl_wait_refresh = OFF: the DDL returns at once (no note)
SET SESSION duckdb_ddl_wait_refresh = OFF;
ALTER TABLE dw ADD COLUMN e INT NOT NULL DEFAULT 7;
SHOW WARNINGS;
SET SESSION duckdb_ddl_wait_refresh = DEFAULT;
--source ../include/wait_applier.inc

UPDATE performance_schema.setup_instruments SET ENABLED = 'NO', TIMED = 'NO'
  WHERE NAME LIKE 'stage/duckdb/%';
UPDATE performance_schema.setup_consumers SET ENABLED = 'NO'
  WHERE NAME = 'events_stages_current';
DROP TABLE dw;
--source ../include/cleanup.inc
