# SUM / AVG of FLOAT and DOUBLE (duckdb_offload_float_aggregates), the
# offload counters (queries run to the end, EXPLAIN, waits), the wait
# timeout variable, and the user's optimizer_switch kept around offload.
--source ../include/have_duckdb.inc
CREATE TABLE fa (id INT PRIMARY KEY, g INT, f DOUBLE, r FLOAT, d DECIMAL(10,2), s VARCHAR(10) COLLATE utf8mb4_bin) SECONDARY_ENGINE = duckdb;
INSERT INTO fa VALUES (1, 1, 1e16, 1.5, 1.10, 'a'), (2, 1, 1, 2.5, 2.20, 'b'), (3, 1, -1e16, 0.1, 3.30, 'c'),
  (4, 2, 0.1, 0.2, 4.40, 'd'), (5, 2, 0.2, 0.3, 5.50, NULL), (6, 2, NULL, NULL, NULL, 'f');
ALTER TABLE fa SECONDARY_LOAD;
CREATE TABLE fb (id INT PRIMARY KEY, a INT) SECONDARY_ENGINE = duckdb;
INSERT INTO fb VALUES (1, 1), (2, 2), (4, 4);
ALTER TABLE fb SECONDARY_LOAD;
--source ../include/wait_applier.inc

--echo # APPROXIMATE is the default
SELECT @@duckdb_offload_float_aggregates;
--echo # REFUSE: SUM / AVG of FLOAT and DOUBLE run on InnoDB
SET SESSION duckdb_offload_float_aggregates = REFUSE;
--let $query= SELECT g, SUM(f) FROM fa GROUP BY g ORDER BY g
--source ../include/duckdb_refused.inc
--let $query= SELECT AVG(r) FROM fa
--source ../include/duckdb_refused.inc
--let $query= SELECT SUM(DISTINCT f), AVG(DISTINCT f) FROM fa
--source ../include/duckdb_refused.inc
--let $query= SELECT SUM(d * 1e0) FROM fa
--source ../include/duckdb_refused.inc
--echo # FLOAT values are sent as FLOAT (shortest float digits, as InnoDB)
--let $query= SELECT id, r, r * 2, f FROM fa ORDER BY id
--source ../include/duckdb_compare.inc
--echo # Exact numbers and MIN / MAX / COUNT of DOUBLE still run in DuckDB
--let $query= SELECT g, SUM(d), AVG(d), MIN(f), MAX(r), COUNT(f) FROM fa GROUP BY g ORDER BY g
--source ../include/duckdb_compare.inc
--echo # APPROXIMATE: they run in DuckDB (values where the order cannot matter)
--let $query= SELECT /*+ SET_VAR(duckdb_offload_float_aggregates = APPROXIMATE) */ g, SUM(r), AVG(r) FROM fa WHERE id IN (1, 2, 6) GROUP BY g ORDER BY g
--source ../include/duckdb_compare.inc
SET SESSION duckdb_offload_float_aggregates = DEFAULT;
--let $query= SELECT COUNT(*) FROM fa HAVING SUM(r) > 0
--source ../include/duckdb_compare.inc
--echo # REFUSE per statement
--let $query= SELECT /*+ SET_VAR(duckdb_offload_float_aggregates = REFUSE) */ AVG(f) FROM fa WHERE id IN (4, 5)
--source ../include/duckdb_refused.inc
--error ER_WRONG_VALUE_FOR_VAR
SET SESSION duckdb_offload_float_aggregates = EXACT;

--echo # duckdb_offload_queries counts runs, EXPLAIN goes to duckdb_offload_explained
SET SESSION use_secondary_engine = FORCED;
--let $q0= query_get_value(SHOW GLOBAL STATUS LIKE 'duckdb_offload_queries', Value, 1)
--let $e0= query_get_value(SHOW GLOBAL STATUS LIKE 'duckdb_offload_explained', Value, 1)
--disable_result_log
EXPLAIN SELECT COUNT(*) FROM fa;
EXPLAIN FORMAT=TREE SELECT g, COUNT(*) FROM fa GROUP BY g;
--enable_result_log
--let $q1= query_get_value(SHOW GLOBAL STATUS LIKE 'duckdb_offload_queries', Value, 1)
--let $e1= query_get_value(SHOW GLOBAL STATUS LIKE 'duckdb_offload_explained', Value, 1)
SELECT COUNT(*) FROM fa;
--let $q2= query_get_value(SHOW GLOBAL STATUS LIKE 'duckdb_offload_queries', Value, 1)
--disable_query_log
--eval SELECT $q1 - $q0 AS queries_after_explain, $e1 - $e0 AS explained, $q2 - $q1 AS queries_after_select
--enable_query_log

--echo # Waits for the session's last commit, with the timeout variable
SELECT @@duckdb_offload_wait_timeout_ms;
SET SESSION duckdb_offload_wait_timeout_ms = 20000;
--let $w0= query_get_value(SHOW GLOBAL STATUS LIKE 'duckdb_offload_waits', Value, 1)
INSERT INTO fa VALUES (7, 3, 7, 7, 7.00, 'g');
SELECT /*+ SET_VAR(duckdb_offload_wait_timeout_ms = 30000) */ COUNT(*) FROM fa WHERE g = 3;
--let $w1= query_get_value(SHOW GLOBAL STATUS LIKE 'duckdb_offload_waits', Value, 1)
--disable_query_log
--eval SELECT $w1 - $w0 > 0 AS waited
--enable_query_log
SET SESSION duckdb_offload_wait_timeout_ms = 4000000;
SELECT @@duckdb_offload_wait_timeout_ms;
SET SESSION duckdb_offload_wait_timeout_ms = DEFAULT;

--echo # optimizer_switch: semi-join materialization is off only while we optimize
SET SESSION use_secondary_engine = ON, secondary_engine_cost_threshold = 0;
--let $sw0= `SELECT @@optimizer_switch`
--let $query= SELECT /*+ SET_VAR(optimizer_switch = 'materialization=on') */ id FROM fa WHERE id IN (SELECT a FROM fb) ORDER BY id
--source ../include/duckdb_compare.inc
SET SESSION use_secondary_engine = ON;
--echo # refused (runs on InnoDB) with the hint
SELECT /*+ SET_VAR(optimizer_switch = 'materialization=on') SET_VAR(duckdb_offload_float_aggregates = REFUSE) */ id, SUM(f) FROM fa WHERE id IN (SELECT a FROM fb) GROUP BY id ORDER BY id;
SELECT id FROM fa WHERE id IN (SELECT a FROM fb) ORDER BY id;
--let $sw1= `SELECT @@optimizer_switch`
--disable_query_log
--eval SELECT '$sw0' = '$sw1' AS optimizer_switch_unchanged, LOCATE('materialization=on', '$sw1') > 0 AS materialization_on
--enable_query_log
SET SESSION optimizer_switch = 'materialization=off';
SELECT id FROM fa WHERE id IN (SELECT a FROM fb) ORDER BY id;
SELECT LOCATE('materialization=off', @@optimizer_switch) > 0 AS still_off;
SET SESSION optimizer_switch = DEFAULT, use_secondary_engine = DEFAULT, secondary_engine_cost_threshold = DEFAULT;

DROP TABLE fa, fb;
--source ../include/cleanup.inc
