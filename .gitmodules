[submodule "storage/rocksdb/rocksdb"]
	path = storage/rocksdb/rocksdb
	url = https://github.com/percona/rocksdb.git
[submodule "extra/coredumper"]
	path = extra/coredumper
	url = https://github.com/Percona-Lab/coredumper.git
[submodule "extra/libkmip"]
	path = extra/libkmip
	url = https://github.com/Percona-Lab/libkmip.git
[submodule "extra/jwt-cpp"]
	path = extra/jwt-cpp
	url = https://github.com/Thalhammer/jwt-cpp
[submodule "extra/duckdb/duckdb"]
	path = extra/duckdb/duckdb
	url = ../../duckdb/duckdb.git
	shallow = true
[submodule "extra/duckdb/ducklake"]
	path = extra/duckdb/ducklake
	url = ../../duckdb/ducklake.git
[submodule "extra/duckdb/croaring"]
	path = extra/duckdb/croaring
	url = ../../RoaringBitmap/CRoaring.git
